# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Optional overrides (sensible defaults are baked into the contact route)
# Inbox that receives contact-form inquiries
CONTACT_TO=jason@rhythmtalent.com
# Verified sender. Until your domain is verified in Resend, use the sandbox:
#   "Rhythm Talent <onboarding@resend.dev>"
# After verifying rhythmtalent.com, switch to e.g. "Rhythm Talent <hello@rhythmtalent.com>"
CONTACT_FROM=Rhythm Talent <onboarding@resend.dev>
